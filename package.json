{
  "name": "atlas-barbell-club",
  "version": "1.0.0",
  "description": "Static website scaffold for Atlas Barbell Club.",
  "scripts": {
    "dev": "tailwindcss -i ./src/styles.css -o ./dist/styles.css --watch",
    "build": "tailwindcss -i ./src/styles.css -o ./dist/styles.css --minify",
    "optimize:svg": "svgo --config ./svgo.config.mjs teamicon.svg platformlogo.svg stopwatchicon.svg clean.svg opengym.svg snatch.svg squat.svg planicon.svg jerk.svg",
    "build:digitalocean": "npm run build && node ./scripts/prepare-digitalocean.mjs",
    "verify:digitalocean": "node ./tests/verify-digitalocean-build.mjs",
    "test": "node ./tests/verify-scroll-animations.mjs && node ./tests/verify-lighthouse-remediation.mjs",
    "test:responsive": "node ./tests/verify-responsive-layout.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "axe-core": "^4.13.0",
    "svgo": "^4.1.0",
    "tailwindcss": "^4.3.3"
  },
  "dependencies": {
    "css.gg": "^2.1.4"
  }
}
